{
  "start": "-PT6H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# ms-vehiculos · DevOps\nMonitoreo del microservicio en AWS EC2 (Docker Compose). Métricas de la EC2, de la app (a partir de sus logs) y del pipeline CI/CD."
      }
    },
    {
      "type": "alarm",
      "x": 0,
      "y": 2,
      "width": 24,
      "height": 3,
      "properties": {
        "title": "Estado de las alarmas",
        "alarms": [
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:ms-vehiculos-cpu-alta",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:ms-vehiculos-memoria-alta",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:ms-vehiculos-errores-5xx",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:ms-vehiculos-errores-4xx"
        ],
        "sortBy": "stateUpdatedTimestamp"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 5,
      "width": 24,
      "height": 4,
      "properties": {
        "title": "Pipeline CI/CD (último despliegue)",
        "region": "__REGION__",
        "metrics": [
          [
            "ms-vehiculos/Pipeline",
            "TestCoverage",
            {
              "label": "Cobertura de pruebas (%)"
            }
          ],
          [
            ".",
            "TestsTotal",
            {
              "label": "Pruebas ejecutadas"
            }
          ],
          [
            ".",
            "DeployDuration",
            {
              "label": "Tiempo de despliegue (s)"
            }
          ],
          [
            ".",
            "LeadTime",
            {
              "label": "Lead time commit → producción (s)"
            }
          ]
        ],
        "stat": "Maximum",
        "period": 86400,
        "view": "singleValue",
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Uso de la EC2 (CPU, memoria, disco)",
        "region": "__REGION__",
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "__INSTANCE_ID__",
            {
              "label": "CPU %",
              "stat": "Average",
              "period": 300
            }
          ],
          [
            "CWAgent",
            "mem_used_percent",
            "InstanceId",
            "__INSTANCE_ID__",
            {
              "label": "Memoria %",
              "stat": "Average"
            }
          ],
          [
            ".",
            "disk_used_percent",
            "InstanceId",
            "__INSTANCE_ID__",
            {
              "label": "Disco %",
              "stat": "Average"
            }
          ]
        ],
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Peticiones HTTP y errores (por minuto)",
        "region": "__REGION__",
        "metrics": [
          [
            "ms-vehiculos/App",
            "HTTPRequests",
            {
              "label": "Peticiones totales"
            }
          ],
          [
            ".",
            "HTTP4xx",
            {
              "label": "Errores 4xx (cliente)",
              "color": "#ff7f0e"
            }
          ],
          [
            ".",
            "HTTP5xx",
            {
              "label": "Errores 5xx (servidor)",
              "color": "#d62728"
            }
          ],
          [
            ".",
            "AppErrors",
            {
              "label": "Líneas ERROR/Exception en logs",
              "color": "#9467bd"
            }
          ]
        ],
        "stat": "Sum",
        "period": 60,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 15,
      "width": 24,
      "height": 5,
      "properties": {
        "title": "Historial del pipeline",
        "region": "__REGION__",
        "metrics": [
          [
            "ms-vehiculos/Pipeline",
            "DeployDuration",
            {
              "label": "Tiempo de despliegue (s)"
            }
          ],
          [
            ".",
            "TestCoverage",
            {
              "label": "Cobertura (%)",
              "yAxis": "right"
            }
          ]
        ],
        "stat": "Maximum",
        "period": 300,
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 20,
      "width": 12,
      "height": 7,
      "properties": {
        "title": "Logs con errores (app)",
        "region": "__REGION__",
        "view": "table",
        "query": "SOURCE '/ms-vehiculos/app' | fields @timestamp, @message | filter @message like /ERROR|Exception|\" 4\\d\\d |\" 5\\d\\d / | sort @timestamp desc | limit 50"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 20,
      "width": 12,
      "height": 7,
      "properties": {
        "title": "Últimos logs del microservicio",
        "region": "__REGION__",
        "view": "table",
        "query": "SOURCE '/ms-vehiculos/app' | fields @timestamp, @message | sort @timestamp desc | limit 50"
      }
    }
  ]
}